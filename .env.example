PORT=3300
HOST=0.0.0.0
TRUST_PROXY=loopback
DATABASE_PATH=./data/bookings.db

# Public base URL used in confirmation emails and links, e.g. https://book.example.com
BASE_URL=http://localhost:3300
# Your IANA time zone; availability hours are defined in this zone
TIMEZONE=UTC
# Name shown on booking pages and in emails
OWNER_NAME=

# Admin sign-in. All three are required together. Generate the key with: openssl rand -base64 48
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_ENCRYPTION_KEY=

# Optional SMTP for confirmation and cancellation emails (ALERT_FROM required to enable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
# Where the owner receives booking notifications (defaults to ALERT_FROM)
OWNER_EMAIL=
# Hours before a booking to send a reminder email (0 disables)
REMINDER_HOURS=24
